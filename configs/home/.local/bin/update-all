#!/usr/bin/env bash
# update-all — update everything: pacman, AUR (paru), flatpak, uv tools, pnpm/cargo globals.
# Usage: update-all [-y]     -y = don't ask for confirmation (pacman/paru --noconfirm)
# Author: Vymnkoo

set -u
NOCONFIRM=()
[[ "${1:-}" == "-y" ]] && NOCONFIRM=(--noconfirm)

# AUR packages we build by hand (bumped PKGBUILD in ~/Projects/aur) — never let paru touch them.
AUR_IGNORE="davinci-resolve"

bold=$'\e[1m'; green=$'\e[32m'; red=$'\e[31m'; yellow=$'\e[33m'; reset=$'\e[0m'
declare -a results=()

step() {  # step "Name" cmd args...
    local name=$1; shift
    printf '\n%s==> %s%s\n' "$bold" "$name" "$reset"
    if "$@"; then
        results+=("${green}✔${reset} $name")
    else
        results+=("${red}✘${reset} $name (exit $?)")
    fi
}
have() { command -v "$1" &>/dev/null; }

# Ask for the sudo password once up front.
sudo -v || { echo "sudo failed, aborting."; exit 1; }

step "pacman (official repos)" sudo pacman -Syu "${NOCONFIRM[@]}"

have paru && step "paru (AUR + -git packages)" \
    paru -Sua --devel --ignore "$AUR_IGNORE" "${NOCONFIRM[@]}"

if have flatpak; then
    step "flatpak (system)" sudo flatpak update --system -y
    [[ -n "$(flatpak list --user --columns=application 2>/dev/null)" ]] && \
        step "flatpak (user)" flatpak update --user -y
    step "flatpak (remove unused runtimes)" sudo flatpak uninstall --system --unused -y
fi

if have uv && [[ -n "$(uv tool list 2>/dev/null | grep -v '^-' | grep -v '^No tools')" ]]; then
    step "uv tools (Python)" uv tool upgrade --all
fi

if have pnpm && ! pnpm ls -g 2>/dev/null | grep -q 'No global packages'; then
    step "pnpm globals" pnpm update -g
fi

if have cargo && have cargo-install-update; then
    step "cargo installs" cargo install-update -a
fi

# ---- summary ----
printf '\n%s==> Summary%s\n' "$bold" "$reset"
printf '  %s\n' "${results[@]}"

# Kernel updated? The running kernel's modules disappear after an upgrade.
if [[ ! -d "/usr/lib/modules/$(uname -r)" ]]; then
    printf '\n%s! Kernel was updated — reboot when you can.%s\n' "$yellow" "$reset"
fi

# Config files pacman couldn't overwrite.
pacnew=$(find /etc -name '*.pacnew' 2>/dev/null)
if [[ -n "$pacnew" ]]; then
    printf '\n%s! New config versions waiting to be merged (.pacnew):%s\n' "$yellow" "$reset"
    printf '    %s\n' $pacnew
fi
