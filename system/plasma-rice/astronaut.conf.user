[General]
# Caelestia Blush login screen - overrides for Themes/astronaut.conf (SDDM reads <ConfigFile>.user on top).
# Same wallpaper as caelestia/Plasma, dark glass panel on the left so the art in the middle stays visible.

Font="Open Sans"
FontSize="13"
RoundCorners="16"
HourFormat="HH:mm"
DateFormat="dddd d MMMM"
HeaderText=""

Background="Backgrounds/caelestia-blush.jpg"
BackgroundPlaceholder=""
CropBackground="true"
DimBackground="0.0"

HeaderTextColor="#ece4e7"
DateTextColor="#ece4e7"
TimeTextColor="#ffffff"

FormBackgroundColor="#1e1a1c"
BackgroundColor="#f5ecef"
DimBackgroundColor="#1e1a1c"

LoginFieldBackgroundColor="#2c2629"
PasswordFieldBackgroundColor="#2c2629"
LoginFieldTextColor="#ece4e7"
PasswordFieldTextColor="#ece4e7"
UserIconColor="#ece4e7"
PasswordIconColor="#ece4e7"

PlaceholderTextColor="#a0949a"
WarningColor="#f0788a"

LoginButtonTextColor="#ffffff"
LoginButtonBackgroundColor="#b06882"
SystemButtonsIconsColor="#ece4e7"
SessionButtonTextColor="#ece4e7"
VirtualKeyboardButtonTextColor="#ece4e7"

DropdownTextColor="#ece4e7"
DropdownSelectedBackgroundColor="#b06882"
DropdownBackgroundColor="#1e1a1c"

HighlightTextColor="#ffffff"
HighlightBackgroundColor="#b06882"
HighlightBorderColor="#d68aa4"

HoverUserIconColor="#e6a6bc"
HoverPasswordIconColor="#e6a6bc"
HoverSystemButtonsIconsColor="#e6a6bc"
HoverSessionButtonTextColor="#e6a6bc"
HoverVirtualKeyboardButtonTextColor="#e6a6bc"

PartialBlur="false"
FullBlur="false"
BlurMax="48"
Blur="2.0"
HaveFormBackground="true"
FormPosition="left"

HideVirtualKeyboard="true"
UseRealName="true"
ForceLastUser="true"
PasswordFocus="true"
